{
  "format_version": "1.8.0",
  "animations": {
    "animation.bear.walk": {
      "anim_time_update": "query.modified_distance_moved",
      "loop": true,
      "bones": {
        "leg0": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * 42.0",
            0,
            0
          ]
        },
        "leg1": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * -42.0",
            0,
            0
          ]
        },
        "leg2": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * -42.0",
            0,
            0
          ]
        },
        "leg3": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * 42.0",
            0,
            0
          ]
        },
        "body": {
          "rotation": [
            0,
            0,
            "math.cos(query.anim_time * 38.17) * 2.0"
          ],
          "position": [
            0,
            "math.abs(math.cos(query.anim_time * 38.17)) * 0.4",
            0
          ]
        }
      }
    },
    "animation.bear.look": {
      "loop": true,
      "bones": {
        "head": {
          "relative_to": {
            "rotation": "entity"
          },
          "rotation": [
            "query.target_x_rotation - this",
            "query.target_y_rotation - this",
            0
          ]
        }
      }
    },
    "animation.bear.sniff": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.sin(query.life_time * 90.0) * 6.0 - 4.0",
            0,
            0
          ]
        }
      }
    }
  }
}
