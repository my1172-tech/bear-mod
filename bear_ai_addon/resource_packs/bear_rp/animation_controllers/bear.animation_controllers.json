{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.bear.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "walk": "query.modified_move_speed"
            },
            {
              "look": "query.has_target"
            },
            {
              "sniff": "1.0 - query.has_target"
            }
          ]
        }
      }
    }
  }
}
